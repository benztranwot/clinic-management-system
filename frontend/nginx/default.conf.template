# nginx renders this template at container start. Only AUTH0_DOMAIN and
# TRUSTED_PROXY_CIDR are substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile).

# Keep the original scheme when a TLS-terminating proxy sits in front of nginx.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Browsers honor HSTS only over HTTPS, so local http://localhost stays usable.
map $forwarded_proto $strict_transport_security {
    https "max-age=31536000; includeSubDomains";
    default "";
}

# Allow scripts and styles from this origin only. Auth0 needs token requests
# (connect-src) and the silent sign-in iframe used by the refresh-token fallback (frame-src).
map $host $content_security_policy {
    default "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://${AUTH0_DOMAIN}; frame-src https://${AUTH0_DOMAIN}; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 64k;

    # Read the visitor's address from X-Forwarded-For only when a trusted proxy sent it.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/snippets/security-headers.conf;

    # Resolve the API again if Compose replaces the container.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api:8080;

    location ~ ^/api(?:/|$) {
        # Send one trusted client address; the API uses it for anonymous rate limits.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_pass $api;
    }

    # Vite fingerprints these files, so browsers can keep them for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/static-compression.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Revalidate index.html so a new deployment loads its new asset names.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/static-compression.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
