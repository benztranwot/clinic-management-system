    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>578caab2-c498-441e-afa5-35648a56afd6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HealthcareApp.Application/HealthcareApp.Application.csproj" />
