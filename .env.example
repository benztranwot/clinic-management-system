# Public settings for your Auth0 SPA and API. Use the domain without https://.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://clinic-management-api

# Use a unique local password with at least 12 characters, including upper and
# lowercase letters, numbers, and a symbol. Avoid double quotes.
MSSQL_SA_PASSWORD=
