# Public settings for your Auth0 SPA and API. Use the domain without https://.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://clinic-management-api

# Use a unique local password with at least 12 characters, including upper and
# lowercase letters, numbers, and a symbol. Avoid double quotes.
MSSQL_SA_PASSWORD=

# Password for the restricted clinic_app database login.
MSSQL_APP_PASSWORD=

# SQL Server edition. Developer is free for local use only; production needs
# Express or a licensed edition (or a managed SQL service instead of this container).
MSSQL_PID=Developer

# Address or dedicated subnet of the TLS proxy that connects to the web container.
# The default trusts loopback. Use the narrowest range matching the proxy's source IP.
TRUSTED_PROXY_CIDR=127.0.0.1/32

# Visitor enrollment and private workspace capabilities. Data isolation stays enabled.
VISITOR_WORKSPACES_ENABLED=true
VISITOR_MAX_WORKSPACES=100
VISITOR_MAX_DAILY_WORKSPACES=20
